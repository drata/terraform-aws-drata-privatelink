# Copy to terraform.tfvars and fill in your own values.

region             = "us-west-2"
name               = "privatelink-example"
vpc_id             = "vpc-xxxxxxxxxxxxxxxxx"
subnet_ids         = ["subnet-aaaaaaaa", "subnet-bbbbbbbb"] # one per AZ, must reach the target
target_instance_id = "i-xxxxxxxxxxxxxxxxx"
target_port        = 443

# Drata's connecting account roots — who may create the interface endpoint.
# acceptance_required = true still gates each connection.
acceptance_required = true
allowed_principals = [
  "arn:aws:iam::269135526815:root", # Drata prod
  "arn:aws:iam::650158175098:root", # Drata QA (test changes here first)
]

# Optional knobs (defaults shown). Uncomment to override.
# health_check_protocol            = "HTTPS"
# health_check_path                = "/-/health"
# listener_port                    = 443
# enable_cross_zone_load_balancing = true
# supported_ip_address_types       = ["ipv4"]

# Drata CIDR by region — confirm which applies with Drata:
#   us-west-2 10.0.0.0/16 (default) | eu-central-1 10.2.0.0/16 | ap-southeast-2 10.10.0.0/16
# nlb_ingress_cidrs = ["10.0.0.0/16"]

# Set "off" if Drata CIDR overlaps your VPC, or if you cannot allow it.
# enforce_security_group_inbound_rules_on_private_link_traffic = "on"

# Private DNS (optional). Lets Drata keep using your existing hostname, so your
# TLS certificate still matches. AWS proves you own the domain with a TXT record
# it resolves over the PUBLIC internet — a private hosted zone will not work.
#
# Public zone in this account: the module writes and verifies the record.
# private_dns_name               = "gitlab.example.com"
# private_dns_validation_zone_id = "Z0123456789ABCDEFGHIJ"
#
# DNS hosted elsewhere: apply once with only private_dns_name set, publish
#   terraform output private_dns_verification_name  ->  _abc123
#   terraform output private_dns_verification_value ->  vpce:XXXXXXXX
# as _abc123.example.com TXT "vpce:XXXXXXXX", then set:
# verify_private_dns_name = true

tags = {
  Project = "privatelink"
}
